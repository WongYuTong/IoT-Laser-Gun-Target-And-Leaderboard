    {
        "id": "f8c2dc0d0916d410",
        "type": "function",
        "z": "b49b08f9bc74e495",
        "name": "Format Scores and Time",
        "func": "let topScores = msg.payload;\nlet formattedText = 'Top 10 Scores:\\n';  // 添加標題並換行\n\nfor (let i = 0; i < topScores.length; i++) {\n    let score = topScores[i].score;\n    let playTime = new Date(topScores[i].play_time).toLocaleString('en-TW', { timeZone: 'Asia/Taipei' });\n    formattedText += `${i + 1}. Score: ${score} | Play Time: ${playTime}\\n`; // 每條數據後加換行\n}\n\nmsg.payload = formattedText;  // 傳遞格式化後的文本\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
