    {
        "id": "5cc1aa85f1c6bbf0",
        "type": "function",
        "z": "b49b08f9bc74e495",
        "name": "Prepare SQL Insert",
        "func": "msg.topic = \"INSERT INTO leaderboard (score, play_time) VALUES (?, ?)\";\nmsg.payload = [\n    parseInt(msg.payload.score) || 0,  // 分數默認為0（若未提供）\n    (function() {\n        let currentDate = new Date();\n        currentDate.setHours(currentDate.getHours() + 8);  // 調整時間 +8 小時（台灣時區）\n\n        // 判斷加 8 小時後的時間是否大於或等於 24 小時\n        if (currentDate.getHours() >= 24) {\n            currentDate.setDate(currentDate.getDate() + 1);  // 如果超過 24 小時，將日期加一天\n            currentDate.setHours(currentDate.getHours() - 24);  // 讓小時數重新計算為 0 到 23 小時\n        }\n\n        return currentDate.toISOString().slice(0, 19).replace('T', ' ');  // 當前時間\n    })()\n];\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
